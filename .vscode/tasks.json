{
    "version": "2.0.0",
    "tasks": [
        {
			"label": "Run RAUSCHEN",
			"type": "shell",
			"group": {
			  "kind": "build",
			  "isDefault": true
			},
			"command": "${config:processing.path}",
			"presentation": {
			  "echo": true,
			  "reveal": "always",
			  "focus": false,
			  "panel": "dedicated"
			},
			"args": [
			  "--force",
			  "--sketch=${workspaceRoot}/rauschen_processing",
			  "--output=${workspaceRoot}/rauschen_processing/out",
			  "--run"
			]
		  },        {
			"label": "Run RAUSCHEN_controls",
			"type": "shell",
			"group": {
			  "kind": "build",
			  "isDefault": true
			},
			"command": "${config:processing.path}",
			"presentation": {
			  "echo": true,
			  "reveal": "always",
			  "focus": false,
			  "panel": "dedicated"
			},
			"args": [
			  "--force",
			  "--sketch=${workspaceRoot}/rauschen_processing_controls",
			  "--output=${workspaceRoot}/rauschen_processing_controls/out",
			  "--run"
			]
		},
		{
			"label": "Run Both",
			"dependsOrder": "parallel",
			"dependsOn": [
				"Run RAUSCHEN",
				"Run RAUSCHEN_controls"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
    ]
}